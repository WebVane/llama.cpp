# Settings of the provision-llm systemd service (deploy/linux/provision-llm.service).
# Install as /etc/provision-llm/provision-llm.env, owner root, group
# provision-llm, mode 0640 (it may hold the admin key and a Hugging Face token):
#
#   sudo install -D -m 0640 -o root -g provision-llm provision-llm.env.example /etc/provision-llm/provision-llm.env
#
# Format (systemd EnvironmentFile): one NAME=value per line.  Lines starting
# with # are comments; a "#" after a value is NOT a comment, it becomes part
# of the value.  No ${...} expansion here.  Quotes around a value are removed.
# After a change:  sudo systemctl restart provision-llm
#
# Every variable here also reaches the model processes the router starts
# (they inherit its environment).  The PROVISION_ADMIN_* variables are the
# exception: the server reads them once and removes them before it starts any
# model process.  Full reference: docs/provision-admin.md.

# ---------------------------------------------------------------------------
# Router (used on the command line in provision-llm.service)
# ---------------------------------------------------------------------------

# Address and port of the server.  With the nginx site
# deploy/linux/nginx-provision-llm.conf in front of it keep 127.0.0.1: nginx
# then keeps /admin restricted to the admin addresses.  Without nginx, listen
# on the LAN address (or 0.0.0.0) and switch on the server's own allow-list,
# PROVISION_ADMIN_ALLOW_FROM in the admin section below.
PROVISION_LLM_HOST=127.0.0.1
PROVISION_LLM_PORT=8080

# How many models may be loaded at the same time (0 = no limit).  Must be at
# least the number of models.ini sections with `load-on-startup = true`,
# otherwise the server refuses to start ("number of models to load on startup
# (N) exceeds models_max (M)").  Once "Max loaded models" has been saved in the
# admin panel the saved value is used instead of this one.
PROVISION_LLM_MODELS_MAX=3

# Further router arguments, split at blanks (paths must not contain spaces).
#   --models-preset FILE  model presets (models.ini); leave it out to serve only
#                         downloaded and dropped-in models
#   --models-dir DIR      "drop a .gguf here, then Rescan"; the directory must
#                         exist, otherwise the server refuses to start.  It is
#                         also where GGUF files uploaded in the admin panel go
#                         (Add model -> Upload GGUF): without --models-dir, or
#                         when provision-llm cannot write there, the panel shows
#                         the upload as unavailable.  Unfinished uploads are kept
#                         in DIR/.provision-upload/ (leave it alone, the server
#                         cleans it up); it must not be another mount.  Models
#                         in DIR can be deleted in the panel (Delete files).
# Do NOT put per-model options such as --ctx-size, --device or --n-gpu-layers
# here: router arguments apply to every model, and the admin panel then shows
# that setting as locked ("set on the server command line") for all of them.
PROVISION_LLM_ARGS="--models-preset /etc/provision-llm/models.ini --models-dir /srv/provision-llm/models-rw/local"

# Model cache: where models downloaded from the admin panel (POST /models) are
# kept.  Needs room for the models you plan to download.  Uploads never go here
# (they go to --models-dir above).
LLAMA_CACHE=/srv/provision-llm/models-rw/hf

# Hugging Face access for downloads, both optional: a token for gated / private
# repositories, and the endpoint of an internal mirror
# (default https://huggingface.co/).
HF_TOKEN=
MODEL_ENDPOINT=

# Optional API key for EVERY route, /admin included (clients send
# "Authorization: Bearer <key>").  Leave unset to keep the API open, as in the
# Docker deployment.
#LLAMA_API_KEY=

# Log detail (journalctl -u provision-llm), for the router and every model
# process: 1 = errors, 2 = warnings, 3 = info (default), 4 = trace, 5 = debug.
# Optional: at 4 the model processes also print their memory breakdown, which
# the GPU cards of the admin panel then show as "reported by the model" instead
# of a measured value or an estimate (the log gets considerably longer).
#LLAMA_ARG_LOG_VERBOSITY=4

# Do NOT set LLAMA_ARG_* variables here for the per-model settings of the admin
# panel (LLAMA_ARG_DEVICE, _CTX_SIZE, _KV_UNIFIED, _KV_UNIFIED_PER_SLOT,
# _N_PARALLEL, _N_GPU_LAYERS, _FLASH_ATTN, _CACHE_TYPE_K, _CACHE_TYPE_V, _UBATCH,
# _EMBEDDINGS, _POOLING, _RERANKING): the model processes inherit them, but the
# panel does not see them, shows the built-in default instead, and a value
# chosen in the panel that equals the built-in default does not override them.
# Put such values into [*] of models.ini.

# ---------------------------------------------------------------------------
# GPUs (all optional; nothing here is needed for the admin panel to work)
# ---------------------------------------------------------------------------

# NVIDIA: number CUDA devices like nvidia-smi does (PCI bus order) instead of
# "fastest first".  Only the CUDA0 / CUDA1 names depend on it: the admin panel
# matches GPUs by PCI bus id.
CUDA_DEVICE_ORDER=PCI_BUS_ID

# Hide GPUs from the server (and from every model process).  The remaining
# GPUs are renumbered from 0; the admin panel still matches them by PCI bus id.
#CUDA_VISIBLE_DEVICES=0,1
#HIP_VISIBLE_DEVICES=0
#GGML_VK_VISIBLE_DEVICES=0
#ONEAPI_DEVICE_SELECTOR=level_zero:0

# ---------------------------------------------------------------------------
# Admin panel (docs/provision-admin.md)
# ---------------------------------------------------------------------------

# 1 / true / on = the /admin API and the Admin page of the web UI; anything
# else = off (/admin answers 404 and the server behaves as without the panel).
PROVISION_ADMIN=1

# Admin key (X-Admin-Key).  Empty = use PROVISION_ADMIN_KEY_FILE, else the key
# in <state dir>/admin.key, which the server generates on the first start:
#   sudo cat /var/lib/provision-llm-admin/admin.key
PROVISION_ADMIN_KEY=
# A file whose first line is the admin key (must be readable by provision-llm).
PROVISION_ADMIN_KEY_FILE=

# Admin state: admin-state.json, admin-models.json (per-model settings), the
# generated admin.key.  Empty = /var/lib/provision-llm-admin, which the unit
# creates (StateDirectory=).  Another directory must exist, be writable for
# provision-llm, and survive reboots and updates.
PROVISION_ADMIN_STATE_DIR=

# Start value of "GPU for new models" (downloaded / dropped-in models without a
# device of their own) until a value is saved in the panel.  Empty = such
# models use all visible GPUs.  Names as `provision-server --list-devices`
# prints them: CUDA0, ROCm0, Vulkan0, SYCL0, ...; several with ";"; none = CPU.
PROVISION_ADMIN_DEFAULT_DEVICE=

# Start value of the pinned models (never unloaded to make room for another
# one), comma-separated model ids, until a list is saved in the panel.
PROVISION_ADMIN_PINNED=

# Where the panel reads the live GPU memory from:
#   auto                 nvidia-smi, amd-smi or rocm-smi, whichever is on PATH (default);
#                        amd-smi / rocm-smi also from $ROCM_PATH/bin and /opt/rocm/bin
#   off                  no vendor tool: memory as measured at start-up / last "Re-detect GPUs"
#   nvidia-smi:/path     a vendor tool that is not on PATH (also amd-smi:/path, rocm-smi:/path,
#                        or just the absolute path: the tool is told by its file name)
#   file:/path           recorded tool output, for tests
# The server finds its GPUs without this (it asks the GPU backend itself);
# the vendor tool only adds memory figures that stay current.
PROVISION_ADMIN_GPU_PROBE=auto
# e.g. for an amd-smi that is neither on PATH nor in /opt/rocm/bin:
#PROVISION_ADMIN_GPU_PROBE=amd-smi:/opt/rocm-6.2.0/bin/amd-smi

# The GPU inventory at start-up: a short helper process of this binary lists
# the GPUs with PCI bus id and memory (it briefly creates a context on each).
#   auto        run it (default)
#   off         skip it: GPU names only, no PCI ids and no start-up memory
#   file:/path  a recorded result, for tests
PROVISION_ADMIN_INVENTORY=auto

# The server's own address allow-list for /admin: every /admin route, the
# status probe included, for a host WITHOUT nginx in front of the server
# (docs/provision-admin.md, section 4.3).  Unset or empty (default) = off:
# any address may use /admin and only the admin key protects it; with the
# nginx site in front, keep the rule in nginx instead.
# IPv4 / IPv6 addresses and CIDR ranges, separated by commas or blanks.
# Other addresses get 403 "admin_forbidden" (logged with the address).  An
# entry the server cannot read (a host name such as localhost, 10.0.0.0/33,
# [::1], ...) is logged as an error and locks /admin for EVERY address until
# it is fixed: a typo never silently drops the restriction.
#PROVISION_ADMIN_ALLOW_FROM=127.0.0.1, ::1, 10.64.0.0/24

# Reverse proxies in front of the server whose X-Forwarded-For is believed;
# only used together with PROVISION_ADMIN_ALLOW_FROM.  Unset (default): the
# header is ignored, because any client can send it, and the TCP peer
# counts.  For a request from a listed proxy the client is the first
# X-Forwarded-For entry, read from the right, that is not a listed proxy.
# Every listed address can claim any client address with a header of its
# own: list only the proxies themselves, never a client network, and do not
# put them into PROVISION_ADMIN_ALLOW_FROM as well.  E.g. the nginx site on
# this host together with the allow-list above (then without 127.0.0.1
# there); processes on this host can then name any address, so for them only
# the admin key applies:
#PROVISION_ADMIN_TRUSTED_PROXIES=127.0.0.1

# MODEL_DEVICES is a feature of the Docker entrypoint (it patches models.ini).
# Do not set it on a host: nothing applies it here, and the panel would only
# warn that it is not applied.  Put `device = ...` into models.ini, or set the
# GPU per model in the panel.
#MODEL_DEVICES=

# ---------------------------------------------------------------------------
# Licensed builds only (built with -DLLAMA_SERVER_LICENSE=ON)
# ---------------------------------------------------------------------------

# License state (signed .lic, request counter); the unit creates the default.
#PROVISION_LICENSE_STATE_DIR=/var/lib/provision-llm
# Activation code applied on the first start (idempotent); it can also be
# entered in the web UI (Settings -> License).
#PROVISION_LICENSE_ACTIVATION_CODE=
