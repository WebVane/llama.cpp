// Auto-generated by CMake's configure_file from
// ${PROVISION_LICENSE_KEYRING_JSON} — DO NOT EDIT.
//
// Source bytes are CI-provisioned (vault → keyring.json) at configure
// time; the contents land here as a single raw-string literal that the
// runtime parses once into Keyring::baked().  The plaintext keyring is
// public material — Ed25519 PUBLIC keys only.  Private signing keys live
// in vault/KMS and never leave the license server.
//
// This TU is linked only when -DPROVISION_LICENSE_KEYRING_JSON=<path> was set
// at configure time.  When absent, the fallback baked() in Keyring.cpp
// returns an empty keyring (which makes every .lic verification fail —
// the safer default than silently trusting a dev keyring in prod).
#include "license/Keyring.h"

#include "log.h"

#define PROVISION_LICENSE_HAS_BAKED_KEYRING 1

namespace visio::license {

const Keyring& Keyring::baked() {
    static const Keyring kr = [] {
        Keyring k;
        // Custom raw-string delimiter ")VISIOLIC_BAKED" avoids any
        // collision with JSON brace/quote sequences in the keyring file.
        constexpr const char* kJson = R"VISIOLIC_BAKED(@PROVISION_LICENSE_KEYRING_JSON_BYTES@)VISIOLIC_BAKED";
        // CMake validated the JSON at configure time; if it still fails here
        // say so loudly instead of running with a silently empty keyring
        // (the startup warning would otherwise blame a missing file).
        if (!k.load_json(std::string_view{kJson}) || k.size() == 0) {
            LOG_ERR("%s", "[license] baked keyring failed to parse or holds no keys - no .lic can be verified\n");
        }
        return k;
    }();
    return kr;
}

}  // namespace visio::license
